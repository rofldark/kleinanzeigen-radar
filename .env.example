# Vorlage: nach .env kopieren und ausfüllen. Die .env wird nicht ins Repository übernommen.
# Alle Werte sind optional – ohne Telegram-Daten läuft die App, verschickt aber keine Nachrichten.

# Telegram-Bot (Token vom @BotFather, Chat-ID z. B. über @userinfobot)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Weboberfläche und Datenablage
# PORT=8080
# DATA_DIR=./data

# Grenzen
# MAX_TELEGRAM_PER_RUN=10
# MAX_LISTINGS=600
# MIN_INTERVAL=30
# MAX_AGE_DAYS=2
# WATCHDOG_EMPTY_RUNS=2
# WATCHDOG_ERROR_RUNS=3
